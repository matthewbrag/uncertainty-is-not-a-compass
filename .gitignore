# Local data: everything the experiments read and write lives in data/ (multi-GB,
# regeneratable by re-running the scripts against the public datasets and model).
data/
*.egg-info/

# Raw collected data and logs -- large (multi-GB) and fully regeneratable
# by running the collection scripts against the public datasets/model.
# Not the source of truth; the scripts are.
*.jsonl
*.log
*.output
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.claude/

# Benchmark/scratch data artifacts from legacy/ scripts -- not source files.
*.npy
util_log*.csv

# Probe artifacts in probes/ (~100-900KB each) are kept in git: they're small,
# and the article's results depend on probes/entropy_probe_1.7b_diversity_level4_best_fixed.json.
.venv-vllm/

# Work-queue counters the GPU workers share during a run
*_queue.txt
